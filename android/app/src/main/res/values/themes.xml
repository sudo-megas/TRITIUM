<?xml version="1.0" encoding="utf-8"?>
<!--
  The XML theme exists only to host the Compose theme. Everything visible is
  painted by Compose (ui/theme/TritiumTheme.kt); this controls the window
  before Compose has drawn a frame.

  The AppCompat parent is deliberate, not a default: MainActivity is an
  AppCompatActivity so that AppCompatDelegate.setApplicationLocales works
  below API 33 (XTRITIUM §3 principle 6; AF1.md §2.1 decision 3).

  windowBackground was AF1.md §2.1 decision 7's own placeholder magenta,
  deliberately wrong so the pre-Compose frame could never be mistaken for
  finished design. AF6b/AF9 closed that fork with native Material 3 plus a
  light/dark/system toggle (TritiumTheme.kt) rather than the desktop's
  eleven picked palettes — no single fixed colour is "the" theme background
  to hardcode here, and this style has no Context to ask Compose's own
  dynamic-colour scheme what it would paint. `?android:attr/colorBackground`
  is what Theme.AppCompat.DayNight already resolves per day/night without
  guessing at a hex value, matching the same system signal
  isSystemInDarkTheme() reads for the app's own default SYSTEM theme mode.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TRITIUM" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

</resources>
